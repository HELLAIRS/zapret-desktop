<ui:FluentWindow
    x:Class="ZapretDesktop.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZapretDesktop.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Zapret Desktop"
    Width="900"
    Height="600"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <ui:TitleBar Grid.Row="0" Title="Zapret Desktop">
            <ui:TitleBar.TrailingContent>
                <ui:Button
                    Appearance="Transparent"
                    Click="OnToggleThemeClick"
                    Icon="{ui:SymbolIcon DarkTheme24}"
                    ToolTip="Сменить тему" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="FrameworkElement">
                        <Setter Property="Margin" Value="0,0,0,12" />
                    </Style>
                </StackPanel.Resources>

                <ui:TextBlock
                    FontTypography="Title"
                    HorizontalAlignment="Center"
                    Text="Zapret Desktop" />

                <ui:TextBlock
                    Appearance="Secondary"
                    HorizontalAlignment="Center"
                    Text="Управление службой обхода блокировок" />

                <ui:CardControl Width="400">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Статус службы" />
                            <ui:TextBlock Appearance="Secondary" Text="Запустить или остановить zapret" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch Content="Включено" />
                </ui:CardControl>

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="FrameworkElement">
                            <Setter Property="Margin" Value="6,0,6,0" />
                        </Style>
                    </StackPanel.Resources>

                    <ui:Button Appearance="Primary" Content="Запустить" />
                    <ui:Button Content="Остановить" />
                    <ui:Button Content="Настройки" Icon="{ui:SymbolIcon Settings24}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>